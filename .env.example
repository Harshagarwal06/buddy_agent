# News Buddy environment variables.
# Copy this file to .env and fill in the values.

# Required when llm.provider: huggingface
HF_TOKEN=

# Required when llm.provider: google; also used by RAG embeddings when enabled
GOOGLE_API_KEY=

# Optional notifiers
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
BUTTONDOWN_API_KEY=
BUTTONDOWN_USERNAME=

# Reserved for future providers/integrations
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
