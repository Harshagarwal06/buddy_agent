# News Buddy environment variables.
# Copy this file to .env and fill in the values.

# Required when llm.provider: huggingface
HF_TOKEN=

# Required when llm.provider: google; also used by RAG embeddings when enabled
GOOGLE_API_KEY=

# Optional notifiers
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
